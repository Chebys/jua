// 用 getItem / setItem 元方法实现「缺失即 0」的计数器。
//
// 计数存在独立的 _ 里，而不是实例自身：
//   * getItem 若用 Object.get（含继承），键与方法同名时会把方法当成计数
//     （c['getItem'] 会返回函数，c['init'] + 1 直接报 type 错）；
//   * 计数写进自身属性又会让数据和类方法共用一个命名空间。
// 所以这里用 Object.getOwn 只查计数表，setItem 也只写计数表。

let Counter = class({
	init(self, data = null){
		self._ = {}
		if(data is Array){
			for(item in data)
				self[item] += 1
		}else if(type(data) == 'object'){
			for([key, value] in Object.pairs(data))
				self[key] = value
		}
	},
	getItem(self, key){
		return Object.getOwn(self._, key, 0)
	},
	setItem(self, key, val){
		self._[key] = val
	}
})

let c = Counter()
c['apple'] += 1
c['banana'] += 2
c['apple'] += 3
print(c['apple'], c['banana'], c['meat'])

let d = Counter({apple = 5, banana = 7})
print(d['apple'], d['banana'], d['meat'])

// 与类方法同名的键也是普通计数：读不到就是 0，不会撞上方法
print(d['getItem'], d['init'])

// 数字键：编码成字节串当作计数表的键
let NumberCounter = class({
	init(self, list = []){
		self._ = {}
		for(n in list)
			self[n] += 1
	},
	getItem(self, n){
		let key = Number.encodeFloat64(n)
		return Object.getOwn(self._, key, 0)
	},
	setItem(self, n, val){
		self._[Number.encodeFloat64(n)] = val
	}
})

let nc = NumberCounter([1, 3, 5, 6, 5, 4, 3, 2])
print(nc[1], nc[3], nc[5], nc[7])
