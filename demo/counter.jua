// 用 getItem / setItem 元方法实现「缺失即 0」的计数器。
//
// 方法定义在原型上，实例自身只存计数。因此 getItem 用 Object.getOwn 就够了：
// 读的是「自己的计数，没有就是 0」，键即使叫 getItem / init 也不会撞上方法。
//
// 代价：写一个与方法同名的键会遮蔽方法（c['init'] = 1 之后 c:init() 就用不了）。
// 需要这层保护时，把计数放进独立的对象里，见下面的 NumberCounter。

let Counter = class({
	init(self, data = null){
		if(data is Array){
			for(item in data)
				self[item] += 1
		}else if(type(data) == 'object'){
			Object.assign(self, data)
		}
	},
	getItem(self, key){
		return Object.getOwn(self, key, 0)
	}
})

let c = Counter()
c['apple'] += 1
c['banana'] += 2
c['apple'] += 3
print(c['apple'], c['banana'], c['meat'])

// 与方法同名的键也是普通计数：读到 0，而不是方法
print(c['getItem'], c['init'])

let d = Counter({apple = 5, banana = 7})
print(d['apple'], d['banana'], d['meat'])

// 数字键要编码成字节串；这类键不适合当属性名，放进独立的 _ 里，
// 顺便也就不会被写入遮蔽类方法。
let NumberCounter = class({
	init(self, list = []){
		self._ = {}
		for(n in list)
			self[n] += 1
	},
	getItem(self, n){
		return Object.getOwn(self._, Number.encodeFloat64(n), 0)
	},
	setItem(self, n, val){
		self._[Number.encodeFloat64(n)] = val
	},
	// 键是编码后的字节串，对外要还原成数字
	pairs(self){
		let out = []
		for([key, count] in Object.pairs(self._))
			out:push([Number.decodeFloat64(key), count])
		return out
	},
	// 顺带成为「对象转字符串」的元方法；顺序取决于底层表
	toString(self){
		let parts = []
		for([n, count] in self:pairs())
			parts:push(String(n) + ': ' + String(count))
		return '{' + parts:join(', ') + '}'
	},
	// json.encode 会先调用它：数字键变成字符串键
	toJSON(self){
		let obj = {}
		for([n, count] in self:pairs())
			obj[String(n)] = count
		return obj
	}
})

let nc = NumberCounter([1, 3, 5, 6, 5, 4, 3, 2])
print(nc[1], nc[3], nc[5], nc[7])
print('pairs  :', nc:pairs():len())
print('string :', String(nc))
print('print  :', nc)
print('json   :', (require 'json').encode(nc))
