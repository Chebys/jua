let Counter = class({
	init(self, data=null){
		if(data is Array){
			for(item in data)
				self[item] += 1
		}else if(type(data) == 'object'){
			Object.assign(self, data)
		}
	},
	getItem(self, key){
		return Object.get(self, key, 0)
	}
})

let c = Counter()
c['apple'] += 1
c['banana'] += 2
c['apple'] += 3

print(c['apple'], c['banana'], c['meat'])

let NumberCounter = class({
	init(self, list=[]){
		self._ = {}
		for(n in list)
			self[n] += 1
	},
	getItem(self, n){
		let key = Number.encodeFloat64(n)
		return if(key in self._) self._[key] else 0
	},
	setItem(self, n, val){
		let key = Number.encodeFloat64(n)
		self._[key] = val
	}
})

let nc = NumberCounter([1,3,5,6,5,4,3,2])
print(nc[1], nc[3], nc[5], nc[7])