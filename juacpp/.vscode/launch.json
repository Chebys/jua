    "version": "0.2.0",
    "configurations": [
        {
            "name": "run a demo",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "jua-build",
            "program": "${workspaceFolder}/../build/jua.exe",
            "args": ["class"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/../demo",
            "environment": []
        },
        {
            "name": "repl",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "repl-build",
            "program": "${workspaceFolder}/../build/repl.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": []
        }

    ]
}
