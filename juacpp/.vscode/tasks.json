{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    // Single host: main.cpp. test.cpp is deprecated and no longer built.
    // Artifacts go to ../build/ so that juacpp/ holds sources only.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "jua-build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20", "-g",
                "-I./include",
                "debug.cpp", "value.cpp", "gc.cpp", "parser.cpp", "program.cpp", "vm.cpp", "m-math.cpp", "m-json.cpp", "main.cpp",
                "-o", "../build/jua.exe"
            ]
        }
    ]
}
