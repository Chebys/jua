// 内置值：Array / Buffer / Function / try / throw
let {eq, ok, throws} = require 'harness'

// Object.get：属性访问（含继承）、默认值、非对象也可用
eq(Object.get({a = 1}, 'a'), 1, 'Object.get own property')
eq(Object.get({}, 'x', 9), 9, 'Object.get default value')
eq(Object.get(5, 'x', 'd'), 'd', 'Object.get works on a non-object')
let Base = class({m(self){ return 'm' }})
ok(Object.get(Base(), 'm') != null, 'Object.get sees inherited properties')

// Number.isInt：无穷不是整数
eq(Number.isInt(3), true, 'isInt on an integer')
eq(Number.isInt(3.5), false, 'isInt on a fraction')
eq(Number.isInt(1 / 0), false, 'isInt on infinity')

// String 以字节为单位
eq(String.byte('abc'), 97, 'byte of the first character')
eq(String.byte('abc', -1), 99, 'byte with a negative index')
eq(String.toHex(''), '', 'toHex of an empty string')
eq(String.toHex('A'), '41', 'toHex of one byte')
throws(fun(){ String.byte('') }, 'byte on an empty string')

let a = Array.of(1, 2, 3)
eq(a:len(), 3, 'array len')
a:push(4)
eq(a:len(), 4, 'push')
eq(a:pop(), 4, 'pop')
eq(a[0], 1, 'getItem')
a[0] = 9
eq(a[0], 9, 'setItem')
eq(a:join('-'), '9-2-3', 'join')
eq(Array.of(1, 2) is Array, true, 'array is instance of Array')

let b = Buffer(4)
b:write('abcd')
eq(b.length, 4, 'buffer length')
eq(b[0], 97, 'buffer item')
eq(b:read(0, 2), 'ab', 'buffer read')

let add = Function('p', 'q', 'return p + q')
eq(add(2, 3), 5, 'Function constructor')

let okres = try{ return 42 }
eq(okres.status, true, 'try ok status')
eq(okres.value, 42, 'try ok value')

// 括号形式与块形式等价
let erres = try(fun(){ throw 'boom' })
eq(erres.status, false, 'try(fun(){ }) 也可用')
ok(type(erres.error) == 'string', 'error surfaces as text')

let viaBlock = try{ throw 'boom' }
eq(viaBlock.status, false, 'try{ } 与之等价')

let caught = null
try{ throw 'oops' }:catch(err){ caught = err }
ok(type(caught) == 'string', 'catch receives the error')

let blockValue = try{ return 5 }
eq(blockValue.value, 5, 'try{ } 内的 return 成为返回的值')

throws(fun(){ throw 'x' }, 'throws helper detects error')

// useNS：把命名空间成员导入对象
let ns = {a = 1, b = 2}
let nsTarget = {}
eq(useNS(nsTarget, ns), null, 'useNS returns null')
eq(nsTarget.a + nsTarget.b, 3, 'useNS copies members')

let imported = {}
useNS(imported, 'math')
ok(imported.PI > 3, 'useNS accepts a module name')
eq(imported.floor(1.9), 1, 'imported function is callable')

let emptyTarget = {}
useNS(emptyTarget, null)
eq(Object.hasOwn(emptyTarget, 'x'), false, 'null namespace is ignored')
throws(fun(){ useNS(1, ns) }, 'useNS requires an object scope')

// 推荐用法：local:useNS 'module'，相当于 import * from 'module'
local:useNS 'json'
eq(encode({a = 1}), '{"a":1}', 'local:useNS imports into the current scope')
