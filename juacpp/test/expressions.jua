// 表达式：优先级、赋值、复合赋值、方法包装、可选访问
let {eq, ok, throws} = require 'harness'

eq(-1 + 2 * (3 - 4), -3, 'precedence')
eq(10 / 4, 2.5, 'division is float')
eq(7 % 4, 3, 'modulo')
eq(-7 % 4, -3, 'modulo keeps the dividend sign (fmod)')
eq(2 ^ 10, 1024, 'power')
eq(2 ^ 0.5 > 1.414 && 2 ^ 0.5 < 1.415, true, 'fractional power')
ok(1 < 2 && 3 > 2, 'logical and')
ok(false || true, 'logical or')
eq(!(1 > 2), true, 'not')
eq(7 >= 7, true, 'ge')
eq(7 <= 6, false, 'le')

let x, y, z
x = y = z = 2
eq(x, 2, 'chained assign x')
eq(y, 2, 'chained assign y')
eq(z, 2, 'chained assign z')

let s = 'ab'
s += 'cd'
eq(s, 'abcd', 'compound add')

let t = null
t ||= 'default'
eq(t, 'default', 'logical assign or')
t &&= 'changed'
eq(t, 'changed', 'logical assign and')

let o = {v = 1}
o.v += 2
eq(o.v, 3, 'property compound assign')

let m = 7
m %= 4
eq(m, 3, 'modulo compound assign')
let o2 = {v = 9}
o2.v %= 4
eq(o2.v, 1, 'property modulo compound assign')

let obj = {name = 'jua', meth(self, n){ return self.name + n }}
eq(obj:meth('!'), 'jua!', 'method wrapper')
let bound = obj:meth
eq(bound('?'), 'jua?', 'method wrapper escapes')
eq(obj?.missing, null, 'optional prop')

// 二元运算：先左操作数的元方法，再右操作数的
let Adder = class({__add(self, o){ return 'added' }})
eq(Adder() + 1, 'added', '左操作数的 __add')
eq(1 + Adder(), 'added', '回退到右操作数的 __add')
eq('s' + Adder(), 'added', '字符串 + 对象也回退')
throws(fun(){ 1 - Adder() }, '没有 __sub 时仍然报错')

let Less = class({__lt(self, o){ return true }})
eq(1 < Less(), true, '回退到右操作数的 __lt')
