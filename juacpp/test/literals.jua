// 字面量：数字、字符串、转义、插值
let {eq} = require 'harness'

eq(123.456, 123.456, 'decimal')
eq(0xfff, 4095, 'hex')
eq(5e-2, 0.05, 'exponent')
eq(-0.5, -0.5, 'negative')

eq('abc\ndef':len(), 7, 'sq escape length')
eq('a\tb':len(), 3, 'tab escape')
eq("q\"q":len(), 3, 'escaped quote')
eq(`abc\ndef`:len(), 8, 'raw string keeps backslash')

let n = 42
eq("n=$n", 'n=42', 'interp word')
eq("n=${n + 1}", 'n=43', 'interp expr')
eq("${'a'}${'b'}", 'ab', 'interp adjacent')

// 转义：\0 只表示 U+0000；\x 直接给字节；\u 按 utf8 编码
eq('\0':len(), 1, 'NUL is one byte')
eq('\0':byte(0), 0, 'NUL is U+0000')
eq('\x41', 'A', 'hex byte')
eq('\u0041', 'A', 'ascii code point')
eq('\u00e9', 'é', 'two-byte utf8 code point')
eq('\u4e2d', '中', 'three-byte utf8 code point')
eq('\u4e2d':len(), 3, 'three-byte utf8 length')
