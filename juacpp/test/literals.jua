// 字面量：数字、字符串、转义、插值
let {eq} = require 'harness'

eq(123.456, 123.456, 'decimal')
eq(0xfff, 4095, 'hex')
eq(0Xff, 255, 'uppercase hex prefix')
eq(0b1010, 10, 'binary')
eq(0B11, 3, 'uppercase binary prefix')
eq(0o17, 15, 'octal')
eq(0O10, 8, 'uppercase octal prefix')
eq(5e-2, 0.05, 'exponent')
eq(1e2, 100, 'exponent without sign')
eq(1e+2, 100, 'exponent with plus')
eq(1E2, 100, 'uppercase E')

// 空数组/空对象字面量
let empty = []
eq(empty:len(), 0, 'empty array literal')
eq(type({}), 'object', 'empty object literal')
eq(-0.5, -0.5, 'negative')

eq('abc\ndef':len(), 7, 'sq escape length')
eq('a\tb':len(), 3, 'tab escape')
eq("q\"q":len(), 3, 'escaped quote')
eq(`abc\ndef`:len(), 8, 'raw string keeps backslash')

let n = 42
eq("n=$n", 'n=42', 'interp word')
eq("n=${n + 1}", 'n=43', 'interp expr')
eq("${'a'}${'b'}", 'ab', 'interp adjacent')

// 字符串模板的 ${ } 配对由词元扫描确定：嵌套括号、字符串里的 }、注释里的 } 都不终止插值
eq("${ {a = 1} }", '[object]', 'nested braces do not end the interpolation')
eq("${ '}' }", '}', 'a brace inside a string does not end the interpolation')
eq("${ 1 /* } */ + 1 }", '2', 'a brace inside a comment does not end the interpolation')
eq("outer=${ "inner=${2}" }", 'outer=inner=2', 'nested template')
eq("dollar=${'$'}", 'dollar=$', 'a literal dollar sign needs an interpolation')

// 转义：\0 只表示 U+0000；\x 直接给字节；\u 按 utf8 编码
eq('\0':len(), 1, 'NUL is one byte')
eq('\0':byte(0), 0, 'NUL is U+0000')
eq('\x41', 'A', 'hex byte')
eq('\u0041', 'A', 'ascii code point')
eq('\u00e9', 'é', 'two-byte utf8 code point')
eq('\u4e2d', '中', 'three-byte utf8 code point')
eq('\u4e2d':len(), 3, 'three-byte utf8 length')
