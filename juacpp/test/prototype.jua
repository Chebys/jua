// 原型：setProto/getProto、自定义迭代器
let {eq, ok} = require 'harness'

let base = {hello(self){ return 'base:' + self.tag }}
let derived = {tag = 'd'}
Object.setProto(derived, base)
eq(derived:hello(), 'base:d', 'method from prototype')
eq(Object.getProto(derived), base, 'getProto')
Object.setProto(derived, null)
eq(Object.getProto(derived), null, 'setProto null')

// 可重复迭代器：不改变自身状态
let Range = class({
    init(self, n){ self.n = n },
    next(self, key){
        key ||= 0
        let done = key >= self.n
        return {key = key + 1, value = key, done}
    }
})
let rg = Range(4)
let s1 = 0
for(v in rg) s1 += v
eq(s1, 6, 'custom iterator first pass')
let s2 = 0
for(v in rg) s2 += v
eq(s2, 6, 'custom iterator is reusable')

// 有状态迭代器同样合法：不返回 key，进度记在自身，因此只能迭代一次
let Counter = class({
    init(self, n){ self.n = n; self.i = 0 },
    next(self){
        if(self.i >= self.n) return {done = true}
        self.i += 1
        return {done = false, value = self.i}
    }
})
let total = fun(c){
    let sum = 0
    for(v in c) sum += v
    return sum
}
let c = Counter(3)
eq(total(c), 6, 'stateful iterator first pass')
eq(total(c), 0, 'stateful iterator is exhausted, which is legal')
