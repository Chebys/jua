// 语句：if/while/for/switch 与 break/continue/return
let {eq, ok} = require 'harness'

// 解构数组
let [dx, dy] = [3, 4]
eq(dx + dy, 7, 'array destructuring')
let [p, q,] = [1, 2]
eq(q, 2, 'array destructuring with trailing comma')

fun grade(n){
    if(n >= 90) return 'A'
    else if(n >= 60) return 'B'
    return 'C'
}
eq(grade(95), 'A', 'if chain 1')
eq(grade(70), 'B', 'if chain 2')
eq(grade(10), 'C', 'if chain 3')

let sum = 0
let i = 0
while(i < 10){
    i += 1
    if(i > 5) break
    if(i == 3) continue
    sum += i
}
eq(sum, 1 + 2 + 4 + 5, 'while with break and continue')

let r = 0
for(k in 1..5) r += k
eq(r, 10, 'for over range is end-exclusive')

// 每个循环节独立绑定：闭包各自捕获本轮的值
let caps = []
for(v in [1, 2, 3]){
    caps:push(fun(){ return v })
}
eq(caps[0](), 1, 'closure keeps its own iteration value')
eq(caps[1](), 2, 'second iteration keeps its value')
eq(caps[2](), 3, 'third iteration keeps its value')

// 循环变量不泄漏到循环之外
let leaked = try{ return v }
eq(leaked.status, false, 'loop variable is not visible after the loop')

// 解构同样按轮独立
let pairCaps = []
for([pk, pv] in Object.pairs({a = 1, b = 2})){
    pairCaps:push(fun(){ return pk })
}
ok((pairCaps[0]() == 'a' && pairCaps[1]() == 'b') ||
   (pairCaps[0]() == 'b' && pairCaps[1]() == 'a'), 'destructured loop vars are per-iteration')

fun sw(n){
    switch(n)
        case(1, 2) return 'low'
        case(3) return 'mid'
        else return 'high'
}
eq(sw(1), 'low', 'switch case 1')
eq(sw(2), 'low', 'switch case 2')
eq(sw(3), 'mid', 'switch case 3')
eq(sw(9), 'high', 'switch else')

fun early(n){
    for(k in 1..100){
        if(k == n) return k
    }
    return -1
}
eq(early(3), 3, 'return from loop')

// if !(...) 是 if(!(...)) 的语法糖
fun sign(n){
    if !(n > 0) return 'non-positive'
    return 'positive'
}
eq(sign(-1), 'non-positive', 'if !(...) negates')
eq(sign(1), 'positive', 'if !(...) falls through')

let n = 0
while !(n >= 3) n += 1
eq(n, 3, 'while !(...)')

eq(if !(true) 'a' else 'b', 'b', 'ternary with !(...)')
